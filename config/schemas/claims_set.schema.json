{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pebs/claims_set",
  "title": "ClaimsSet",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "version", "text"],
        "properties": {
          "claim_id": { "type": "string" },
          "version": { "type": "integer" },
          "text": { "type": "string" },
          "claim_type": { "type": "string" },
          "population": { "type": "string" },
          "usage": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "unavailable": { "type": "array", "items": { "type": "string" } }
  }
}
