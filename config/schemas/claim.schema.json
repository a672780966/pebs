{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pebs/claim",
  "title": "Claim",
  "type": "object",
  "required": ["claim_id", "version", "text", "claim_type", "status"],
  "properties": {
    "claim_id": { "type": "string" },
    "version": { "type": "integer" },
    "text": { "type": "string" },
    "claim_type": { "enum": ["descriptive", "correlational", "predictive", "causal", "mechanistic", "theoretical", "speculative"] },
    "population": { "type": "string" },
    "usage": { "type": "string" },
    "status": { "enum": ["PENDING", "SUPPORTED", "QUALIFY_REQUIRED", "UNSUPPORTED", "DISPUTED", "HUMAN_REVIEW_REQUIRED"] },
    "created_at": { "type": "string" }
  }
}
